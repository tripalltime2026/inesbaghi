APP_NAME="ინეს ბაღი"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_LOCALE=ka
APP_FALLBACK_LOCALE=en
APP_TIMEZONE=Asia/Tbilisi
LOG_CHANNEL=stack
LOG_LEVEL=debug

# Zero-config demo defaults. Attach PostgreSQL and override these values
# before moving from the temporary demo environment to production.
DB_CONNECTION=sqlite
DB_DATABASE=
SESSION_DRIVER=file
SESSION_LIFETIME=120
CACHE_STORE=file
FILESYSTEM_DISK=private

DEMO_AUTH_ENABLED=true
DEMO_ADMIN_PHONE=555411831
DEMO_AUTO_MIGRATE=true

OTP_TTL_MINUTES=5
OTP_MAX_ATTEMPTS=5
