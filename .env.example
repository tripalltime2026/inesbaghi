APP_NAME="ინეს ბაღი"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_LOCALE=ka
APP_FALLBACK_LOCALE=en
APP_TIMEZONE=Asia/Tbilisi
LOG_CHANNEL=stack
LOG_LEVEL=debug

# Canonical public domain used by SEO metadata, structured data and sitemap.
SEO_SITE_URL=https://inesbaghi.ge

# Zero-config demo defaults. Attach PostgreSQL and override these values
# before moving from the temporary demo environment to production.
DB_CONNECTION=sqlite
DB_DATABASE=
SESSION_DRIVER=file
SESSION_LIFETIME=120
CACHE_STORE=file
FILESYSTEM_DISK=private

# Keep demo authentication disabled on public production environments.
DEMO_AUTH_ENABLED=false
DEMO_ADMIN_PHONE=
DEMO_AUTO_MIGRATE=true

OTP_TTL_MINUTES=5
OTP_MAX_ATTEMPTS=5

# Ines AI works with deterministic live database answers even when disabled.
# Enable the provider for natural-language answers after adding a server-side API key.
INES_AI_ENABLED=false
OPENAI_API_KEY=
INES_AI_MODEL=gpt-5-mini
OPENAI_BASE_URL=https://api.openai.com
INES_AI_SHOW_EXACT_AVAILABILITY=false
